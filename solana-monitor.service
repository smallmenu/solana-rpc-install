[Unit]
Description=Solana RPC Performance Monitor
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/performance-monitor.sh monitor
Restart=on-failure
RestartSec=10
User=root
Environment="PATH=/usr/local/solana/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin"
Environment="RPC_URL=http://127.0.0.1:8899"
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
