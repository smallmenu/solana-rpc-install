[Unit]
Description=Solana Validator
After=network.target network-online.target
Wants=network-online.target
RequiresMountsFor=/root/sol/accounts /root/sol/accounts_index /root/sol/ledger /root/sol/snapshot
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Keep a failed validator stopped so its disk state can be inspected before recovery.
Restart=no
User=root
LimitNOFILE=1000000
LimitNPROC=1000000
LimitMEMLOCK=infinity
LimitSTACK=infinity
LimitCORE=infinity
LogRateLimitIntervalSec=0
Environment="PATH=/usr/local/solana/bin:/usr/bin:/bin"
Environment="RUST_LOG=warn"
Environment="RUST_BACKTRACE=full"
# Keep the validator preferred while retaining 10% host-memory recovery headroom.
OOMScoreAdjust=-900
# Avoid throttling replay on memory.high; MemoryMax is a last-resort cgroup boundary.
MemoryHigh=infinity
MemoryMax=90%
# CPU affinity and scheduling
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=0
# Watchdog disabled - node initialization takes longer than 2 minutes
# WatchdogSec=120
# Graceful shutdown timeout
TimeoutStopSec=300
KillMode=mixed
KillSignal=SIGINT
# Working directory
WorkingDirectory=/root/sol
# Startup command (auto-selects appropriate validator script based on RAM)
ExecStart=/bin/bash -c '/root/sol/bin/select-validator.sh'
# Capture filesystem and kernel state immediately after an unexpected exit.
ExecStopPost=-/bin/bash /root/solana-failure-diagnostics.sh
# Pre-start validation
ExecStartPre=/bin/bash -c 'test -f /root/sol/bin/validator-keypair.json'
ExecStartPre=/bin/bash -c 'test -d /root/sol/ledger'
ExecStartPre=/bin/bash -c 'test -d /root/sol/accounts'
ExecStartPre=/bin/bash -c 'test -d /root/sol/accounts_index'

[Install]
WantedBy=multi-user.target
